# Public RPC endpoint. Override per-environment. Never commit a private endpoint with an API key.
EXPO_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CLUSTER=devnet

# Program IDs — devnet defaults. See protocol-core/Anchor.toml for canonical values.
EXPO_PUBLIC_ENTROS_ANCHOR_PROGRAM_ID=GZYwTp2ozeuRA5Gof9vs4ya961aANcJBdUzB7LN6q4b2
EXPO_PUBLIC_ENTROS_VERIFIER_PROGRAM_ID=4F97jNoxQzT2qRbkWpW3ztC3Nz2TtKj3rnKG8ExgnrfV
EXPO_PUBLIC_ENTROS_REGISTRY_PROGRAM_ID=6VBs3zr9KrfFPGd6j7aGBPQWwZa5tajVfA7HN6MMV9VW

# Executor base URL — provides /challenge and /validate-features for the
# wallet-connected verify flow. Required for Stage 4 onwards. Devnet executor
# lives at https://intelligent-energy-production-d478.up.railway.app.
EXPO_PUBLIC_RELAYER_URL=
# Optional X-API-Key header value for the executor. Leave blank in dev unless
# the local executor was started with EXECUTOR_API_KEYS set.
EXPO_PUBLIC_RELAYER_API_KEY=
