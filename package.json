{
  "name": "entros-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Development client for Entros behavioral verification on Solana Mobile and Seeker",
  "license": "MIT",
  "homepage": "https://entros.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entros-protocol/entros-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/entros-protocol/entros-mobile/issues"
  },
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "measure:fingerprint-architecture": "ENTROS_EMIT_FINGERPRINT_ARCHITECTURE_MANIFEST=1 NODE_OPTIONS=--experimental-vm-modules jest --runInBand --runTestsByPath src/extraction/__tests__/fingerprint-architecture.test.ts --testNamePattern \"emits the shared Node source-path manifest contract\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
