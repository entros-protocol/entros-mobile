{
    "name": "mopro-ffi",
    "version": "0.1.0",
    "description": "Mopro FFI bindings for React Native",
    "main": "./src/index.tsx",
    "exports": {
        ".": {
            "source": "./src/index.tsx",
            "default": "./src/index.tsx"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "react-native.config.js",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*",
        "*.xcframework/**"
    ],
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zkmopro/react-native-app.git"
    },
    "author": "ZK Mopro Team (https://zkmopro.com)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/zkmopro/react-native-app/issues"
    },
    "homepage": "https://github.com/zkmopro/react-native-app#readme",
    "peerDependencies": {
        "react": "*",
        "react-native": "*"
    },
    "codegenConfig": {
        "name": "MoproFFISpec",
        "type": "modules",
        "jsSrcsDir": "src",
        "android": {
            "javaPackageName": "com.moproffi"
        }
    },
    "dependencies": {
        "uniffi-bindgen-react-native": "^0.29.3-1"
    }
}
