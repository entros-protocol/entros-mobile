# Build artefacts that get re-generated by `mopro build` upstream and by
# `npm install` (builder-bob) at consumer side. Vendored only the source
# files (cpp/, ios/, android/, src/) and the compiled .so. lib/ is no
# longer shipped — package.json `main` points at src/index.tsx so Metro
# transforms TS on the fly without needing builder-bob.
node_modules/
example/
*.log
.idea/
.vscode/
.gradle/
android/.cxx/
android/build/
lib/
