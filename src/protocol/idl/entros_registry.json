          "name": "verification_count",
          "type": "u32"
        },
        {
          "name": "creation_timestamp",
          "type": "i64"
        },
        {
          "name": "recent_timestamps",
          "type": {
            "array": ["i64", 10]
          }
        }
      ]
    },
