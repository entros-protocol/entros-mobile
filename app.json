{
  "expo": {
    "name": "Entros",
    "slug": "entros-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "entros",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/entros.png",
    "splash": {
      "image": "./assets/entros.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "io.entros.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Entros records a short voice sample on this device. Audio is processed locally and discarded immediately after a 308-feature statistical summary is extracted.",
        "NSMotionUsageDescription": "Entros samples motion sensors to measure how you hold the phone. Raw sensor data stays on this device and is discarded immediately after feature extraction.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.entros.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/entros.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
